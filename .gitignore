!/hypr/
!/hypr-backup-2026-11-04/
!/kitty/
!/gtk-3.0/
!/gtk-4.0/
!/qt6ct/
!/environment.d/
!/uwsm/
!/swash/
!/fontconfig/
!/mimeapps.list
!/mimeapps.list.bak-dolphin
!/kdeglobals
!/kdeglobals.bak
__pycache__/
*.pyc
