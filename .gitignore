# Allowlist: only the rice is tracked. Browsers, app state and anything else
# under ~/.config stay out of the repo.
/*
!/.gitignore
!/README.md
!/docs/
!/noctalia/
!/hypr/
!/kitty/
!/gtk-3.0/
!/gtk-4.0/
!/qt6ct/
!/environment.d/
!/uwsm/
!/swash/
!/fontconfig/
!/mimeapps.list
!/kdeglobals
!/fish/
!/lazygit/
__pycache__/
*.pyc
noctalia/plugins-local/graphite/bin/
# fish: universal variables are machine state, completions are generated
/fish/fish_variables
/fish/completions/
