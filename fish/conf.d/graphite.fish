# Graphite colors for fish: the same grey ramp as the bar, with the muted
# terminal accents for errors, strings and paths.
set -g __fish_git_prompt_showdirtystate yes
set -g __fish_git_prompt_char_dirtystate '*'
set -g __fish_git_prompt_char_stagedstate '+'
set -g __fish_git_prompt_color_branch 7a7f86

set -g fish_color_normal d3d6d9
set -g fish_color_command ededeb --bold
set -g fish_color_keyword a6abb1 --bold
set -g fish_color_param d3d6d9
set -g fish_color_option a6abb1
set -g fish_color_quote a3b19f
set -g fish_color_redirection 7a7f86
set -g fish_color_end 7a7f86
set -g fish_color_operator 7a7f86
set -g fish_color_escape 9fb3b2
set -g fish_color_comment 7a7f86 --italics
set -g fish_color_error c9a3a0
set -g fish_color_valid_path --underline
set -g fish_color_autosuggestion 4b4f54
set -g fish_color_search_match --background=33363a
set -g fish_color_selection --background=33363a
set -g fish_color_cancel c9a3a0
set -g fish_pager_color_prefix ededeb --bold
set -g fish_pager_color_completion d3d6d9
set -g fish_pager_color_description 7a7f86
set -g fish_pager_color_progress 7a7f86
set -g fish_pager_color_selected_background --background=26282b
