config_version = 16

[accessibility]
ui_scale = 1.0000000074505806

[bar.default]
border = "outline_variant"
border_width = 1
capsule_border = "outline_variant"
capsule_border_width = 1
capsule_group = []
capsule_radius = 8
center = [ "vyeos/graphite:clock" ]
end = [
    "vyeos/graphite:status",
    "vyeos/graphite:tasks",
    "vyeos/graphite:wifi",
    "vyeos/graphite:bluetooth",
    "vyeos/graphite:audio",
    "vyeos/graphite:battery",
    "vyeos/graphite:notifications"
]
font_family = "Graphite Sans"
hover_highlight = false
margin_edge = 0
margin_ends = 0
padding = 10
radius = 0
radius_bottom_left = 0
radius_bottom_right = 0
radius_top_left = 0
radius_top_right = 0
scale = 1.0000000074505806
start = [ "vyeos/graphite:logo", "vyeos/graphite:workspaces", "vyeos/graphite:window" ]
thickness = 38
widget_spacing = 2

[bluetooth]
connect_when_enabled = true
connection_notifications = true

[brightness]
sync_all_monitors = true

[control_center]
hidden_tabs = [ "weather", "calendar", "notifications", "screen-time" ]

[desktop_widgets]
schema_version = 2
widget_order = []

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [desktop_widgets.widget]

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [ "lockscreen-login-box@eDP-2" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@eDP-2"]
    box_height = 196.0
    box_width = 810.0
    cx = 720.0
    cy = 718.0
    output = "eDP-2"
    placement_height = 900.0
    placement_width = 1440.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@eDP-2".settings]
        background_color = "surface_container"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_password_reveal = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

[plugins]
enabled = [ "vyeos/graphite" ]

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"

    [[plugins.source]]
    kind = "path"
    location = "/home/vyeos/.config/noctalia/plugins-local"
    name = "local"

[shell]
clipboard_enabled = false
corner_radius_scale = 0
font_family = "Graphite Sans"
telemetry_enabled = true

    [shell.animation]
    speed = 0.5000000074505806

    [shell.launcher]
    default_view = "all"

    [shell.panel]
    transparency_mode = "soft"

    [shell.screenshot]
    copy_on_close = true
    copy_to_clipboard = true
    directory = "/home/vyeos/Pictures"
    skip_annotate_on_copy_save = true

[system.monitor]
enabled = false

[theme]
builtin = "Noctalia"
community_palette = "Oxocarbon"
custom_palette = "Graphite"
mode = "dark"
pure_black_dark = false
source = "custom"
wallpaper_scheme = "m3-content"

    [theme.templates]
    builtin_ids = [ "btop", "gtk3", "gtk4", "kcolorscheme", "kitty", "qt" ]

[wallpaper]
directory = "/home/vyeos/Downloads"

    [wallpaper.default]
    path = "/home/vyeos/Downloads/wallhaven-5ypy88.jpg"

    [wallpaper.last]
    path = "/home/vyeos/Downloads/wallhaven-5ypy88.jpg"

    [wallpaper.monitors.eDP-2]
    path = "/home/vyeos/Downloads/wallhaven-5ypy88.jpg"

[widget.clock]
format = "{:%H:%M %a %d %m}"

[widget.notifications]
capsule = true
capsule_fill = "surface_container"
color = "on_surface_variant"