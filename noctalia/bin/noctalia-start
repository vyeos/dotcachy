#!/bin/sh
# Start Noctalia for this Hyprland session and make sure it actually comes up.
#
# On 2026-11-12 the shell froze about a second into its first start after boot (main
# thread spinning, nothing drawn, so the session sat on Hyprland's grey background);
# the same build started fine the second time. Until the cause is known, this checks
# the shell answers on its IPC socket and restarts it if it doesn't. A healthy shell
# answers in a few milliseconds; a frozen one never does.
#
# Run from hypr/config/autostart.lua in place of plain "noctalia".

# Square password marks on the lock screen: Noctalia only offers circles or random icons,
# so ../assets holds the stock assets (symlinks) plus an icon font whose circle-filled glyph
# is a smaller square (built by ../assets/square-mask: cd there and go run .). Use it only while the stock font
# is the one it was built from; after a Noctalia update, stock circles until it is rebuilt.
STOCK_SHA=352fffc1e9024e5a1ddb5fbf9db532dae793839ae338b6e8234f32e792a8723c
assets="$(dirname "$(readlink -f "$0")")/../assets"
if [ -f "$assets/fonts/noctalia-tabler.ttf" ] &&
   [ "$(sha256sum /usr/share/noctalia/assets/fonts/noctalia-tabler.ttf | cut -d' ' -f1)" = "$STOCK_SHA" ]; then
  export NOCTALIA_ASSETS_DIR="$(readlink -f "$assets")"
else
  logger -t noctalia-start "stock icon font changed, square password marks off until assets/square-mask is rerun (go run .)"
fi

tries=0
while [ $tries -lt 3 ]; do
  noctalia &
  pid=$!
  ok=0
  # give it up to ~12 s to answer
  for wait in 3 3 3 3; do
    sleep $wait
    kill -0 $pid 2>/dev/null || break                # it exited on its own
    if timeout 2 noctalia msg wallpaper-get >/dev/null 2>&1; then ok=1; break; fi
  done
  [ $ok = 1 ] && exit 0
  tries=$((tries + 1))
  logger -t noctalia-start "noctalia (pid $pid) did not answer after start, restarting (attempt $tries)"
  kill -9 $pid 2>/dev/null
  sleep 1
done
logger -t noctalia-start "noctalia failed to start 3 times, giving up"
notify-send -u critical "Noctalia" "The shell failed to start. Run noctalia from a terminal to see why." 2>/dev/null
