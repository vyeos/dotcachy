#!/bin/sh
# windows-bootnext — make the next boot (only the next one) start Windows Boot
# Manager, skipping Limine. Run as root; the session panel calls it through
# sudo and then reboots the normal way, so apps still close cleanly.
#
# Install (root-owned copy, so the sudoers rule can't be used to run edited code):
#   sudo sh ~/.config/noctalia/bin/windows-bootnext install     (in a terminal)
#   pkexec sh ~/.config/noctalia/bin/windows-bootnext install   (graphical password prompt)
set -eu

if [ "${1:-}" = install ]; then
  [ "$(id -u)" = 0 ] || { echo "run with sudo or pkexec" >&2; exit 1; }
  user=${SUDO_USER:-}
  if [ -z "$user" ] && [ -n "${PKEXEC_UID:-}" ]; then
    user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
  fi
  [ -n "$user" ] && [ "$user" != root ] || { echo "run with sudo or pkexec from your own user" >&2; exit 1; }
  install -o root -g root -m 0755 "$0" /usr/local/bin/windows-bootnext
  printf '%s ALL=(root) NOPASSWD: /usr/local/bin/windows-bootnext\n' "$user" > /etc/sudoers.d/windows-bootnext.tmp
  chmod 0440 /etc/sudoers.d/windows-bootnext.tmp
  visudo -cf /etc/sudoers.d/windows-bootnext.tmp >/dev/null
  mv /etc/sudoers.d/windows-bootnext.tmp /etc/sudoers.d/windows-bootnext
  echo "installed /usr/local/bin/windows-bootnext and /etc/sudoers.d/windows-bootnext"
  exit 0
fi

[ $# -eq 0 ] || { echo "usage: windows-bootnext [install]" >&2; exit 2; }

# Look the entry up by name each time: its Boot#### number can change after
# firmware updates or a Windows reinstall.
num=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} *Windows Boot Manager.*/\1/p' | head -n1)
[ -n "$num" ] || { echo "no Windows Boot Manager entry found" >&2; exit 1; }
efibootmgr --bootnext "$num" >/dev/null
echo "next boot: Windows Boot Manager (Boot$num)"
